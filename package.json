{
  "dependencies": {
    "@actual-app/api": "^26.10.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/env": "^7.0.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "pino-pretty": "^13.2.0"
  },
  "name": "actualtap",
  "version": "1.0.39",
  "description": "Automatically create transactions in Actual Budget when you use Tap-to-Pay on a mobile device",
